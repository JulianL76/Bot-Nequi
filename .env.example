# --- Telegram / IA (núcleo compartido) ---
TELEGRAM_TOKEN=tu_token_de_botfather
GROQ_API_KEY=tu_api_key_de_groq
GROQ_API_KEY_BACKUP=
GEMINI_API_KEY=tu_api_key_de_gemini

# Modelos (opcionales, traen valores por defecto)
# OJO: llama-3.2-11b-vision-preview está DADO DE BAJA en Groq (responde 400).
# Por eso IA_PREFERIDA es "gemini": con Groq primero, cada imagen gastaba una
# subida que siempre fallaba antes de caer al respaldo.
# GROQ_MODEL=<un modelo de visión vigente en Groq>
# GEMINI_MODEL=gemini-2.5-flash
# IA_PREFERIDA=gemini          # "groq" solo si GROQ_MODEL apunta a uno vigente

# Lado mayor al que se reduce la imagen antes de mandarla a la IA.
# Gemini cobra igual sin importar el tamaño (medido: 261 tokens con 449x1024 y
# con 3000x4000), así que achicar de más solo quita nitidez a la referencia.
# IMAGEN_MAX_PX=1600

# Tope de tamaño de un .zip subido (MB). El límite del navegador es solo
# cosmético; este es el que de verdad protege al servidor.
# MAX_ZIP_MB=200

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Procesamiento por lotes ---
BATCH_SIZE=30

# --- Celery / Redis ---
# En Windows local: Redis vía WSL/Docker/Memurai. Si no hay broker, usar EAGER.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# --- Notificaciones push (PWA) ---
# Generar UNA vez con: python manage.py gen_vapid
# Si se dejan vacías, el push queda apagado y la campanita in-app y Telegram
# siguen funcionando igual. Si se cambian, todos los usuarios tienen que volver
# a aceptar el permiso.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=
