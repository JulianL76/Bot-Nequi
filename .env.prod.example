# Copia a .env.prod y rellena. NO se commitea (.env.prod está en .gitignore).
#   cp .env.prod.example .env.prod

# --- Dominio / HTTPS ---
# Tu IP pública con nip.io (guiones en vez de puntos). Ej. IP 34.120.45.67:
DOMAIN=34-120-45-67.nip.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://34-120-45-67.nip.io

# --- Django ---
# Genera una nueva: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=34-120-45-67.nip.io,web,localhost

# --- IA (claves de API) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Ritmo de procesamiento (opcional) ---
# BATCH_SIZE=30
# DATA_UPLOAD_MAX_NUMBER_FILES=900
